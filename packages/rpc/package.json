{
  "name": "@trivia-night/rpc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./group": {
      "@trivia-night/source": "./src/group.ts",
      "types": "./dist/group.d.ts",
      "default": "./dist/group.js"
    },
    "./handlers": {
      "@trivia-night/source": "./src/handlers.ts",
      "types": "./dist/handlers.d.ts",
      "default": "./dist/handlers.js"
    },
    "./service": {
      "@trivia-night/source": "./src/service.ts",
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./server": {
      "@trivia-night/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./live": {
      "@trivia-night/source": "./src/live.layer.ts",
      "types": "./dist/live.layer.d.ts",
      "default": "./dist/live.layer.js"
    },
    "./test": {
      "@trivia-night/source": "./src/test.layer.ts",
      "types": "./dist/test.layer.d.ts",
      "default": "./dist/test.layer.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./group": {
        "types": "./dist/group.d.ts",
        "default": "./dist/group.js"
      },
      "./service": {
        "types": "./dist/service.d.ts",
        "default": "./dist/service.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./live": {
        "types": "./dist/live.layer.d.ts",
        "default": "./dist/live.layer.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@trivia-night/domain": "workspace:*",
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.107",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
